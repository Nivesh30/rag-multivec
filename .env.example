# --- Logging ---
LOG_LEVEL=INFO

# --- Embedding backend ---
# One of: voyage | openai | sentence_transformers
VECTORIZER_BACKEND=sentence_transformers
VECTORIZER_MODEL=
VECTORIZER_MAX_RETRIES=2
# Chunks are embedded in batches of this size per ingest() call, so a large
# ingest doesn't hit a provider's per-request size/rate limits.
VECTORIZER_BATCH_SIZE=100
VOYAGE_API_KEY=
OPENAI_API_KEY=

# --- Vector store (Chroma) ---
VECTOR_STORE_BACKEND=chroma
CHROMA_COLLECTION=documents
# Leave unset for an in-memory (ephemeral) store; set to persist to disk.
CHROMA_PERSIST_DIR=

# --- Generation ---
# One of: anthropic | openai
GENERATION_PROVIDER=anthropic
GENERATION_MODEL=
GENERATION_MAX_TOKENS=2048
GENERATION_MAX_RETRIES=2
ANTHROPIC_API_KEY=

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_HYBRID=true
RETRIEVAL_RRF_K=60
