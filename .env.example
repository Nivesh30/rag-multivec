# --- Embedding backend ---
# One of: voyage | openai | sentence_transformers
VECTORIZER_BACKEND=sentence_transformers
VECTORIZER_MODEL=
VOYAGE_API_KEY=
OPENAI_API_KEY=

# --- Vector store (Chroma) ---
VECTOR_STORE_BACKEND=chroma
CHROMA_COLLECTION=documents
# Leave unset for an in-memory (ephemeral) store; set to persist to disk.
CHROMA_PERSIST_DIR=

# --- Generation ---
# One of: anthropic | openai
GENERATION_PROVIDER=anthropic
GENERATION_MODEL=
GENERATION_MAX_TOKENS=2048
ANTHROPIC_API_KEY=

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_HYBRID=true
RETRIEVAL_RRF_K=60
